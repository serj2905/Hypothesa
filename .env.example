# Скопируй в .env и заполни. .env в git НЕ коммитим (см. .gitignore).

# Ollama HTTP-эндпоинт. На 5080-боксе — localhost.
OLLAMA_HOST=http://localhost:11434

# Генератор: интервьюер + суммаризатор (live, Qwen).
LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# Судья: ДРУГОЕ семейство (batch-фаза). См. sprint_1.md про self-preference bias.
JUDGE_MODEL=llama3.1:8b

LLM_TIMEOUT=120
LLM_RETRIES=2

# Использование VRAM Ollama. q8_0 — безопасная стартовая точка для KV-cache.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=10m

# Postgres: состояние интервью + завершённые записи. См. storage.py.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hypothesa

# Перевыпущенные токены (старые из DHA_hackathon/sets.py — ОТОЗВАТЬ):
TELEGRAM_TOKEN=

# Стабильный случайный секрет для псевдонимизации Telegram user id.
PARTICIPANT_SALT=replace-with-a-long-random-secret
SURVEY_ID=sber-service-quality
ADAPTIVE_SHARE=0.5
DATA_RETENTION_DAYS=90
BOT_MAX_CONCURRENT_LLM_REQUESTS=1

# BERTopic / адаптивная анкета.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
TOPIC_RANDOM_STATE=42
TOPIC_MIN_SIZE=5
TOPIC_SIMILARITY_THRESHOLD=0.82
TOPIC_MIN_MENTIONS=2
TOPIC_MIN_PREVALENCE=0.05
TOPIC_QUESTION_COUNT=2

# Автоматический offline-конвейер.
TOPIC_MIN_VALID_INTERVIEWS=50
TOPIC_REFRESH_EVERY=10
TOPIC_COOLDOWN_HOURS=24
AUTOMATION_INTERVAL_MINUTES=30
AUTOMATION_BATCH_LIMIT=500
AUTOMATION_TIMEZONE=Europe/Moscow
AUTOMATION_WINDOW_START_HOUR=2
AUTOMATION_WINDOW_HOURS=3
AUTOMATION_REQUIRE_NO_ACTIVE_SESSIONS=true
AUTOMATION_ACTIVE_GRACE_MINUTES=30
